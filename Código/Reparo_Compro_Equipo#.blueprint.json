{
    "name": "Reparo_Compro_Equipo#",
    "flow": [
        {
            "id": 1,
            "module": "telegram:WatchUpdates",
            "version": 1,
            "parameters": {
                "__IMTHOOK__": 3055641
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0,
                    "name": "Recibir mensajes"
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "96a361bbd9b43d04"
                },
                "restore": {
                    "parameters": {
                        "__IMTHOOK__": {
                            "data": {
                                "editable": "false"
                            },
                            "label": "ReparoCompro"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTHOOK__",
                        "type": "hook:telegramapi",
                        "label": "Webhook",
                        "required": true
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "ai-local-agent:RunLocalAIAgent",
            "version": 0,
            "parameters": {
                "makeConnectionId": 10624849
            },
            "filter": {
                "name": "Solo texto, sin comandos",
                "conditions": [
                    [
                        {
                            "a": "{{1.message.text}}",
                            "o": "exist"
                        },
                        {
                            "a": "{{1.message.text}}",
                            "b": "/",
                            "o": "text:notstartwith"
                        }
                    ]
                ]
            },
            "mapper": {
                "files": [],
                "message": "Aparato y falla: {{1.message.text}}",
                "threadId": "reparo-{{now}}",
                "outputType": "text",
                "tokenLimit": "50",
                "modelConfig": {
                    "timeout": "",
                    "recursionLimit": "300",
                    "aiCompactionEnabled": true,
                    "iterationsFromHistoryCount": "10"
                },
                "defaultModel": "medium",
                "systemPrompt": "Eres un asesor de reparacion de aparatos para alumnos de Desarrollo Sustentable del TecNM en Mazatlan, Sinaloa.\nEl usuario describe un aparato y su falla. Responde en texto plano (sin asteriscos, sin markdown), en espanol, con este formato:\n\nAparato: [que es]\nCausa probable: [1 linea]\nTipo de obsolescencia: [planificada / percibida / ninguna, con 1 linea de explicacion]\n¿Tiene reparacion?: [si / no / depende]\nCosto aproximado de reparacion: [rango en pesos mexicanos]\nCosto aproximado de uno nuevo: [rango en pesos mexicanos]\nImpacto si se desecha: [materiales que contiene y por que contamina]\nRECOMENDACION: [REPARAR / REEMPLAZAR / DONAR O RECICLAR, con 1 linea de razon]\nQue hacer: [donde repararlo o a donde llevarlo si se desecha]\n\nAclara que los costos son aproximados y que conviene pedir una cotizacion.\nSi el mensaje no describe un aparato con falla, responde: \"Describe el aparato y su falla, por ejemplo: laptop de 4 años que se calienta y se apaga.\"",
                "promptCaching": "none",
                "fallbackEnabled": false
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {
                    "parameters": {
                        "makeConnectionId": {
                            "data": {
                                "scoped": "true",
                                "connection": "ai-provider"
                            },
                            "label": "Make's AI Provider (default)"
                        }
                    }
                }
            },
            "tools": []
        },
        {
            "id": 3,
            "module": "telegram:SendReplyMessage",
            "version": 1,
            "parameters": {
                "__IMTCONN__": 12292426
            },
            "mapper": {
                "text": "{{2.response}}",
                "chatId": "{{1.message.chat.id}}",
                "parseMode": "",
                "replyMarkup": "",
                "messageThreadId": "",
                "replyToMessageId": "",
                "disableNotification": false,
                "disableWebPagePreview": false,
                "replyMarkupAssembleType": "reply_markup_enter"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0,
                    "name": "Responder en Telegram"
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "465b5f28444bf298"
                },
                "restore": {
                    "expect": {
                        "parseMode": {
                            "label": "Empty"
                        },
                        "disableNotification": {
                            "mode": "chose"
                        },
                        "replyMarkupAssembleType": {
                            "label": "Enter the Reply Markup"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "telegram"
                            },
                            "label": "Reparo_compro"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:telegram",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "chatId",
                        "type": "text",
                        "label": "Chat ID",
                        "required": true
                    },
                    {
                        "name": "text",
                        "type": "text",
                        "label": "Text",
                        "required": true
                    },
                    {
                        "name": "messageThreadId",
                        "type": "number",
                        "label": "Message Thread ID"
                    },
                    {
                        "name": "parseMode",
                        "type": "select",
                        "label": "Parse Mode",
                        "validate": {
                            "enum": [
                                "Markdown",
                                "HTML"
                            ]
                        }
                    },
                    {
                        "name": "disableNotification",
                        "type": "boolean",
                        "label": "Disable Notifications"
                    },
                    {
                        "name": "disableWebPagePreview",
                        "type": "boolean",
                        "label": "Disable Link Previews"
                    },
                    {
                        "name": "replyToMessageId",
                        "type": "number",
                        "label": "Original Message ID"
                    },
                    {
                        "name": "replyMarkupAssembleType",
                        "type": "select",
                        "label": "Enter/Assemble the Reply Markup Field",
                        "validate": {
                            "enum": [
                                "reply_markup_enter",
                                "reply_markup_assemble"
                            ]
                        }
                    },
                    {
                        "name": "replyMarkup",
                        "type": "text",
                        "label": "Reply Markup"
                    }
                ]
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us2.make.com",
        "notes": []
    }
}